# Path to the scraper SQLite file. Relative paths are from the web/ folder.
DRAMA_DB_PATH=../data/chartdrama.db

# Turso (libSQL) cloud database credentials.
# Get these from: https://turso.tech
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Fallback to local SQLite if Turso vars are not set (for local dev).
# If neither TURSO_ vars nor DRAMA_DB_PATH is set, defaults to ../data/chartdrama.db