# Admin console: the admin sign-in and session key live in the database
# (change them on the console's My Account page, no redeploy needed).
# Optional, first setup only: if no admin account exists yet, these create it
# on the first sign-in. Once it exists they're ignored and can be removed.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# App-user tokens (required). At least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
USER_TOKEN_SECRET=

# Transition period only: accept requests with a body `userId` and no token,
# for accounts that have never been issued a token. Remove once the app update is out.
USER_AUTH_ALLOW_LEGACY=true

# Sign in with Google: comma-separated OAuth client IDs whose ID tokens are accepted.
# With Android Credential Manager, use the *Web application* client ID you pass as
# serverClientId (Google Cloud Console > APIs & Services > Credentials).
GOOGLE_OAUTH_CLIENT_IDS=

# Firebase Authentication (Android app guest + Google sign-in via /api/user/firebase-session).
# The Firebase project id from the app's google-services.json. Defaults to short-rewards-app.
FIREBASE_PROJECT_ID=short-rewards-app

# Only accounts with a linked Google account can redeem coins (anti-fraud). Off by default.
REDEEM_REQUIRE_GOOGLE=false

# Ad rewards: require a unique claim ID per ad view (Idempotency-Key header or claimId).
# Leave false until the app version that sends it is released, then set true.
REQUIRE_AD_CLAIM_ID=false

# Timezone that decides when a "day" rolls over for check-ins and daily limits.
APP_TIMEZONE=Asia/Karachi
